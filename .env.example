# Copy to .env with `make init` (fills TAILSCALE_IP and asks for CONTACT_EMAIL,
# then chmod 600). .env is gitignored; keep secrets only there.

# Tailscale IPv4 of this host (`tailscale ip -4`). The web port is published only here.
TAILSCALE_IP=

# Host port for the web UI (bound to TAILSCALE_IP only).
WEB_PORT=8091

# Contact address for the outbound User-Agent. Wikimedia and SEC EDGAR require one.
# Sent only to the data-source APIs, never shown on the site.
CONTACT_EMAIL=

# Host directory for all persistent state (restic backs up /storage).
STORAGE_DIR=/storage/newsroom

TZ=America/Toronto
LOG_LEVEL=INFO

# Per-client-IP rate limits.
RATE_LIMIT=120/minute
SEARCH_RATE_LIMIT=30/minute

# Comma-separated Host header allowlist. "*" is fine behind Tailscale;
# set to your public hostname(s) before going public.
ALLOWED_HOSTS=*

# Comma-separated CIDRs of reverse proxies whose CF-Connecting-IP / X-Forwarded-For
# headers are trusted for rate limiting. Leave empty behind Tailscale.
TRUSTED_PROXIES=

# Only enable once the site is served over HTTPS (see docs/going-public.md).
ENABLE_HSTS=false

# Ingestion: how often, how far back the very first run reaches (GDELT keeps ~3 months),
# and how long articles are kept (0 = forever).
INGEST_INTERVAL_MINUTES=15
# Runs are aligned to the clock, this many minutes after each GDELT update
# (15 and 3 -> :03, :18, :33, :48 UTC). The worker also runs once 30 s after start.
INGEST_OFFSET_MINUTES=3

# Publication dates: every 15 min (5 min after each ingest), read the publication time from
# new article pages' metadata (only the date is kept; robots.txt obeyed; 1 request/s).
# Limits per pass.
PUBDATE_FETCH=true
PUBDATE_PER_RUN=150
PUBDATE_MAX_AGE_DAYS=1
INGEST_BACKFILL_HOURS=48
# After downtime or GDELT errors, outlets resume at most this many hours back, so the
# feed catches up quickly instead of re-fetching a long backlog.
INGEST_CATCHUP_HOURS=6
# Where articles come from: gkg = GDELT's 15-minute files (recommended, no request
# quota); doc = the DOC 2.0 search API (rate-limited per IP address).
INGEST_SOURCE=gkg
RETENTION_DAYS=365

# Ownership: each outlet's Wikidata chain is re-checked after this many days.
OWNERSHIP_REFRESH_DAYS=7

# Nightly SQLite snapshot: local hour, and how many to keep.
BACKUP_HOUR=3
BACKUP_KEEP=14

# Balanced feed: the most articles shown per outlet per hour, so a few busy outlets
# (often wire-heavy ones) do not crowd out the rest. Visitors can pick "Show: Everything".
FEED_OUTLET_CAP=3
